# ===== locally authored annotated configs =====
# They live in cfg/cfgogl/zonemod_annotated/, a sibling of cfg/cfgogl/zonemod/.
# cfg/ and cfg/cfgogl/ must be re-included first, otherwise git never enters
# those directories and no rule for a deeper path can take effect.
!cfg/
!cfg/cfgogl/
!cfg/cfgogl/zonemod_annotated/
!cfg/cfgogl/zonemod_annotated/*.cfg

# ===== locally authored docs (upstream does not track these) =====
# !docs/ is required: git never evaluates a per-file negation inside an
# excluded directory, so a new docs/ file needs the directory re-included.
!docs/

!addons/sourcemod/data/

# ===== original .gitignore of the repository follows =====
# Windows thumbnail cache files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# =========================
# Operating System Files
# =========================

.DS_Store

# Visual Studio Code files
/.vscode

# SourcePawn local build output. Shipped plugins live in
# addons/sourcemod/plugins/, not in the scripting source tree.
addons/sourcemod/scripting/compiled/
addons/sourcemod/scripting/**/*.smx

# Codex local build scratch output.
/.codex-build/

